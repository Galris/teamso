{
  "name": "teamup-auth-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 test/firebase.test.js",
    "test:workspace": "node --test --test-concurrency=1 test/workspace.test.js",
    "test:notifications": "node --test --test-concurrency=1 test/notifications.test.js",
    "test:workspace:emulators": "firebase emulators:exec --project demo-teamup-workspace --only auth,firestore --config ../firebase.workspace-test.json \"node --test --test-concurrency=1 test/notifications.test.js test/workspace.test.js\"",
    "local": "node scripts/dev-local.js",
    "emulators": "node scripts/emulators.js",
    "api": "node scripts/start-local.js",
    "firebase:save": "node scripts/save-emulators.js",
    "firebase:check-cloud": "node scripts/check-cloud.js",
    "test:unit": "node --test test/task_notifications.test.js test/workspace_options.test.js test/direct_chats.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
