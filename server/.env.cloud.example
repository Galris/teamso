PORT=3000
USE_FIREBASE_EMULATORS=false
FIREBASE_PROJECT_ID=teamup-7ae78
# Project settings > General > Your apps > TeamUp Backend > apiKey
FIREBASE_WEB_API_KEY=replace-with-teamup-web-api-key
# Absolute path to YOUR credentials outside this repository (forward slashes on Windows).
# See FIREBASE_CLOUD.md for user OAuth ADC setup.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YOUR_NAME/AppData/Roaming/gcloud/application_default_credentials.json
# Do not set FIREBASE_AUTH_EMULATOR_HOST or FIRESTORE_EMULATOR_HOST in cloud mode.
