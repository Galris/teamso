{
  "info": {
    "_postman_id": "005feeca-b013-4ca5-aa64-775579b13a2d",
    "name": "TeamUp - Firebase Auth & Profile (Local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order 00 -> 10. Select TeamUp Local environment. Signup creates a new synthetic account each run. No real tokens are included in this file."
  },
  "item": [
    {
      "name": "00 - Health (Firebase)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Backend uses Firestore', function () { pm.expect(pm.response.json().database).to.eql('Cloud Firestore'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Signup / Dang ky",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signup",
        "description": "Creates a NEW local test account on every Send. Uses no personal email or existing account.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"{{displayName}}\",\n  \"major\": \"Flutter Developer\",\n  \"phone\": \"0912345678\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.environment.set('username', 'nghi_pm_' + suffix);",
              "pm.environment.set('email', 'nghi_pm_' + suffix + '@example.com');",
              "pm.environment.set('password', pm.environment.get('initialPassword') || 'TeamUp-test-123');",
              "pm.environment.unset('accessToken');",
              "pm.environment.unset('refreshToken');",
              "pm.environment.unset('previousAccessToken');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Signin / Dang nhap",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signin",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Response has both tokens', function () {",
              "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
              "    pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
              "  });",
              "  pm.environment.set('accessToken', data.accessToken);",
              "  pm.environment.set('refreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Me / Xem ho so",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Correct account and no password hash', function () {",
              "  const user = pm.response.json().user;",
              "  pm.expect(user.username).to.eql(pm.environment.get('username'));",
              "  pm.expect(user).not.to.have.property('hashPassword');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Profile / Luu ho so",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/profile",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"{{displayName}} - Updated\",\n  \"major\": \"Flutter & Firebase\",\n  \"phone\": \"0912345678\",\n  \"bio\": \"Kiem thu API TeamUp bang Postman.\",\n  \"avatarUrl\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Profile saved', function () { pm.expect(pm.response.json().user.major).to.eql('Flutter & Firebase'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Refresh / Cap lai token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/refresh",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Response has both tokens', function () {",
              "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
              "    pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
              "  });",
              "  pm.environment.set('accessToken', data.accessToken);",
              "  pm.environment.set('refreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Change password / Doi mat khau",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users/change-password",
        "description": "Changes ONLY the generated test account password. Run request 07 to log in again.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  pm.environment.set('password', pm.environment.get('newPassword'));",
              "  pm.environment.unset('accessToken'); pm.environment.unset('refreshToken');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Signin with new password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signin",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Response has both tokens', function () {",
              "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
              "    pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
              "  });",
              "  pm.environment.set('accessToken', data.accessToken);",
              "  pm.environment.set('refreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Signout / Dang xuat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signout",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 1200);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  pm.environment.set('previousAccessToken', pm.environment.get('accessToken'));",
              "  pm.environment.unset('accessToken'); pm.environment.unset('refreshToken');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Old token rejected (expected 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{previousAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Invalid refresh rejected (expected 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/refresh",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"invalid-test-token\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    }
  ]
}
