rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isMember(pid) {
      let p = get(/databases/$(database)/documents/projects/$(pid)).data;
      return signedIn() && (
        request.auth.uid == p.ownerId ||
        (p.memberIds is list && request.auth.uid in p.memberIds) ||
        exists(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid))
      );
    }

    // Kiểm tra tên đăng nhập trước khi đăng ký (chưa đăng nhập) nên cho get.
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;

      // Chỉ mục dự án: chỉ backend (Admin SDK) ghi.
      match /projectMemberships/{pid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Người dùng chỉ được đánh dấu đã đọc thông báo của chính mình.
      match /notifications/{nid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    match /projects/{pid} {
      // Không cho client ghi trực tiếp: tạo/tham gia/sửa đi qua backend.
      allow read: if signedIn() && (
        request.auth.uid == resource.data.ownerId ||
        (resource.data.memberIds is list && request.auth.uid in resource.data.memberIds) ||
        exists(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid))
      );
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(pid);
        allow write: if false;
      }
      match /tasks/{tid} {
        allow read: if isMember(pid);
        allow write: if false;
      }
      match /activities/{aid} {
        allow read: if isMember(pid);
        allow write: if false;
      }

      match /messages/{mid} {
        allow read: if isMember(pid);
        allow create: if isMember(pid) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      // Workspace schema: documents(label,url), meetings(label,startsAt,endsAt),
    // votes(question,options), ballots/{uid}(options). The API validates every
    // mutation, creator identity, bounds and membership using Admin SDK.
    // Direct client mutations are denied; realtime member reads remain enabled.
    match /documents/{id} {
      allow read: if isMember(pid);
      allow write: if false;
    }
    match /meetings/{id} {
      allow read: if isMember(pid);
      allow write: if false;
    }
    match /votes/{id} {
      allow read: if isMember(pid);
      allow write: if false;
      match /ballots/{uid} {
        allow read: if isMember(pid) && exists(/databases/$(database)/documents/projects/$(pid)/votes/$(id));
        allow write: if false;
      }
    }
  }
 }
}
